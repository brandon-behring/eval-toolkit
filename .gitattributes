# Force LF line endings on the canonical doctest-module list so the
# `xargs < .doctest-modules` invocation in ci.yml works on Windows
# runners (CRLF would smuggle \r into the argv and pytest would error
# with "file or directory not found"). See A3 / v0.27.0 commit
# (a26fd44) for the regression context.
.doctest-modules text eol=lf
