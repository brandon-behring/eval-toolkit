# Top-most EditorConfig file
# https://editorconfig.org/
root = true

# Universal defaults
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python — Black-formatted (100-char line length per pyproject.toml)
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

# YAML — 2-space indent (GitHub Actions + mkdocs convention)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON (incl. JSON schemas + the public_api snapshot)
[*.json]
indent_style = space
indent_size = 2

# Markdown — preserve trailing whitespace (it has semantic meaning for line breaks)
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# TOML (pyproject.toml etc.)
[*.toml]
indent_style = space
indent_size = 4

# Makefile — tabs are load-bearing
[Makefile]
indent_style = tab

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2
